n = int(input("Enter the total number of users: "))


matrix = [[0 for _ in range(n)] for _ in range(n)]


adj_list = [[] for _ in range(n)]

connections = int(input("Enter the number of connections: "))


for i in range(connections):
    u, v = map(int, input("Enter connection (user1 user2): ").split())

    matrix[u][v] = 1
    matrix[v][u] = 1

    adj_list[u].append(v)
    adj_list[v].append(u)

print("\nAdjacency Matrix:")
for row in matrix:
    print(*row)

print("\nAdjacency List:")
for i in range(n):
    print(i, "->", adj_list[i])

u, v = map(int, input("\nEnter two users to check friendship: ").split())


if matrix[u][v] == 1:
    print("Using Adjacency Matrix: Users are directly connected.")
else:
    print("Using Adjacency Matrix: Users are not directly connected.")

if v in adj_list[u]:
    print("Using Adjacency List: Users are directly connected.")
else:
    print("Using Adjacency List: Users are not directly connected.")

